{
  "name": "ziwei-lite",
  "version": "1.0.0-beta.1",
  "description": "Lightweight TypeScript Zi Wei Dou Shu rules built on js-ephemeris-lite",
  "type": "module",
  "license": "MPL-2.0",
  "keywords": [
    "ziwei",
    "zi-wei-dou-shu",
    "purple-star-astrology",
    "chinese-astrology",
    "chinese-calendar",
    "lunar-calendar",
    "astrology",
    "destiny",
    "typescript"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "docs",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.zh-CN.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate:rules": "node tools/generate-rules.mjs ../../../taiyin-ephemeris/ziwei_astrology/rules src/generated/default-rules.ts",
    "test:examples": "tsc -p tsconfig.examples.json",
    "test": "npm run build && npm run test:examples && node --test test/*.test.mjs",
    "prepack": "npm test"
  },
  "dependencies": {
    "js-ephemeris-lite": "^1.0.0-beta.1"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RedSC1/js-ephemeris-lite.git",
    "directory": "packages/ziwei"
  },
  "bugs": {
    "url": "https://github.com/RedSC1/js-ephemeris-lite/issues"
  },
  "homepage": "https://github.com/RedSC1/js-ephemeris-lite/tree/main/packages/ziwei#readme"
}
