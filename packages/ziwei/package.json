{
  "name": "@opendestiny/ziwei-lite",
  "version": "0.0.0",
  "private": true,
  "description": "Work-in-progress lightweight Zi Wei Dou Shu rules built on js-ephemeris-lite",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate:rules": "node tools/generate-rules.mjs ../../../taiyin-ephemeris/ziwei_astrology/rules src/generated/default-rules.ts",
    "test:examples": "tsc -p tsconfig.examples.json",
    "test": "npm run build && npm run test:examples && node --test test/*.test.mjs"
  },
  "dependencies": {
    "js-ephemeris-lite": "file:../.."
  }
}
