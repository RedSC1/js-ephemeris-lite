{
  "name": "js-ephemeris-lite",
  "version": "1.0.0-beta.1",
  "description": "Long-range JavaScript ephemeris and Chinese calendar toolkit with positions, sky events, eclipses, solar terms, lunar phases, Ganzhi, and solar time",
  "type": "module",
  "license": "MPL-2.0",
  "author": "RedSC1",
  "sideEffects": false,
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "docs",
    "src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_NOTICES.zh-CN.md"
  ],
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./ephemeris": {
      "types": "./src/ephemeris.d.ts",
      "default": "./src/ephemeris.js"
    },
    "./eclipses": {
      "types": "./src/eclipses.d.ts",
      "default": "./src/eclipses.js"
    },
    "./eclipse-search": {
      "types": "./src/eclipse-search.d.ts",
      "default": "./src/eclipse-search.js"
    },
    "./apparent": {
      "types": "./src/apparent.d.ts",
      "default": "./src/apparent.js"
    },
    "./event-search": {
      "types": "./src/event-search.d.ts",
      "default": "./src/event-search.js"
    },
    "./phenomena": {
      "types": "./src/phenomena.d.ts",
      "default": "./src/phenomena.js"
    },
    "./orbital-events": {
      "types": "./src/orbital-events.d.ts",
      "default": "./src/orbital-events.js"
    },
    "./body-visibility": {
      "types": "./src/body-visibility.d.ts",
      "default": "./src/body-visibility.js"
    },
    "./coordinates": {
      "types": "./src/coordinates.d.ts",
      "default": "./src/coordinates.js"
    },
    "./calendar-events": {
      "types": "./src/calendar-events.d.ts",
      "default": "./src/calendar-events.js"
    },
    "./chinese-calendar": {
      "types": "./src/chinese-calendar.d.ts",
      "default": "./src/chinese-calendar.js"
    },
    "./chinese-era": {
      "types": "./src/chinese-era.d.ts",
      "default": "./src/chinese-era.js"
    },
    "./ganzhi": {
      "types": "./src/ganzhi.d.ts",
      "default": "./src/ganzhi.js"
    },
    "./qi-shuo": {
      "types": "./src/qi-shuo.d.ts",
      "default": "./src/qi-shuo.js"
    },
    "./solar-visibility": {
      "types": "./src/solar-visibility.d.ts",
      "default": "./src/solar-visibility.js"
    },
    "./solar-time": {
      "types": "./src/solar-time.d.ts",
      "default": "./src/solar-time.js"
    },
    "./time": {
      "types": "./src/time.d.ts",
      "default": "./src/time.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ephemeris",
    "astronomy",
    "lunar-calendar",
    "chinese-calendar",
    "ganzhi",
    "solar-terms",
    "lunar-phases",
    "solar-eclipse",
    "lunar-eclipse",
    "sky-events",
    "equation-of-time",
    "true-solar-time"
  ],
  "scripts": {
    "demo": "node examples/ephemeris.mjs",
    "build:workspaces": "npm run build --workspaces --if-present",
    "generate:historical-calendar-data": "node tools/generate-calendar-data.mjs",
    "generate:huangli-zh-hant": "node scripts/build-huangli-zh-hant.mjs",
    "verify:chinese-era-data": "node tools/verify-chinese-era-data.mjs",
    "test": "node --test",
    "test:types": "tsc -p tsconfig.types.json",
    "test:workspaces": "npm run test --workspaces --if-present",
    "prepack": "npm test && npm run test:types"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RedSC1/js-ephemeris-lite.git"
  },
  "bugs": {
    "url": "https://github.com/RedSC1/js-ephemeris-lite/issues"
  },
  "homepage": "https://github.com/RedSC1/js-ephemeris-lite#readme"
}
