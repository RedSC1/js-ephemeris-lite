{
  "name": "js-ephemeris-lite",
  "version": "0.1.0",
  "description": "Lightweight long-range ephemeris, Chinese lunisolar calendar, Ganzhi, and solar visibility for JavaScript",
  "type": "module",
  "license": "MPL-2.0",
  "author": "RedSC1",
  "sideEffects": false,
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./ephemeris": {
      "types": "./src/ephemeris.d.ts",
      "default": "./src/ephemeris.js"
    },
    "./coordinates": {
      "types": "./src/coordinates.d.ts",
      "default": "./src/coordinates.js"
    },
    "./calendar-events": {
      "types": "./src/calendar-events.d.ts",
      "default": "./src/calendar-events.js"
    },
    "./chinese-calendar": {
      "types": "./src/chinese-calendar.d.ts",
      "default": "./src/chinese-calendar.js"
    },
    "./ganzhi": {
      "types": "./src/ganzhi.d.ts",
      "default": "./src/ganzhi.js"
    },
    "./solar-visibility": {
      "types": "./src/solar-visibility.d.ts",
      "default": "./src/solar-visibility.js"
    },
    "./time": {
      "types": "./src/time.d.ts",
      "default": "./src/time.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ephemeris",
    "astronomy",
    "lunar-calendar",
    "chinese-calendar",
    "ganzhi",
    "solar-terms"
  ],
  "scripts": {
    "demo": "node src/ephemeris.js",
    "test": "node --test",
    "test:types": "tsc -p tsconfig.types.json",
    "prepack": "npm test && npm run test:types"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RedSC1/js-ephemeris-lite.git"
  },
  "bugs": {
    "url": "https://github.com/RedSC1/js-ephemeris-lite/issues"
  },
  "homepage": "https://github.com/RedSC1/js-ephemeris-lite#readme"
}
