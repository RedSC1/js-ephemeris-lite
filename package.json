{
  "name": "js-ephemeris-lite",
  "version": "0.1.0",
  "description": "Lightweight long-range ephemeris, Chinese lunisolar calendar, Ganzhi, and solar visibility for JavaScript",
  "type": "module",
  "license": "MPL-2.0",
  "author": "RedSC1",
  "sideEffects": false,
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./ephemeris": "./src/ephemeris.js",
    "./coordinates": "./src/coordinates.js",
    "./calendar-events": "./src/calendar-events.js",
    "./chinese-calendar": "./src/chinese-calendar.js",
    "./ganzhi": "./src/ganzhi.js",
